# В образ попадает только то, что сервис запускает. Всё остальное делает
# сборку дольше, а образ больше, и ничего не добавляет.

.git
.gitignore
.gitlab-ci.yml
README.md
Makefile
*.md

# Тесты, кэши инструментов, виртуальные окружения.
tests/
.pytest_cache/
.ruff_cache/
.mypy_cache/
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
.venv_*/

# Лабораторная сборка на двух процессах. В кластере сервис работает в одном
# процессе на CPU, и воркеры там не запускаются.
workers/

# Манифесты деплоя читает AIDA, а не контейнер.
deployment/

# Машинное окружение GPU-машины. Его в репозитории и нет, строка на случай
# локальной сборки.
config/gpu_env.py

# Видео, кадры, результаты прогонов: всё это живёт в лабораторном
# репозитории, а не в образе.
videos/
runs/
results/
datasets*/
*.mp4
*.avi

.DS_Store
.vscode/
.idea/
